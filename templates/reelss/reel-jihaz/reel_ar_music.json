   "cues": [
    {
     "t0": 0.2,
     "t1": 4.5,
     "text": "هذه الأجهزة التي أصبحت مع الناس في أيديهم وبيوتهم"
    },
    {
     "t0": 4.5,
     "t1": 10.5,
     "text": "أصبحت قرينًا للمرء، ملازمًا له، ويصاحبها باستمرار"
    },
    {
     "t0": 10.5,
     "t1": 16.5,
     "text": "وكم أضعفت من إيمان",
     "emph": true
    },
    {
     "t0": 16.5,
     "t1": 23.5,
     "text": "هذا الجهاز الذي يحمله كثير من الناس في أيديهم وفي جيوبهم"
    },
    {
     "t0": 23.5,
     "t1": 28.5,
     "text": "كم كان له من أثر في ضعف الإيمان ورقّة الدين",
     "emph": true
    },
    {
     "t0": 28.5,
     "t1": 33.5,
     "text": "بسبب ما يُبَثّ فيه ويدخل فيه من وسائل الهدم"
    },
    {
     "t0": 33.5,
     "t1": 41.5,
     "text": "للدين والخلق والعقيدة، مما أضرّ بكثير من الشباب"
    },
    {
     "t0": 41.5,
     "t1": 45.5,
     "text": "ولهذا إغلاق المنافذ التي تضعف الإيمان",
     "emph": true
    },
    {
     "t0": 45.5,
     "t1": 50.5,
     "text": "ويترتب عليها رقّة الدين، هذا مطلب أساس"
    },
    {
     "t0": 50.5,
     "t1": 56.5,
     "text": "أمّا أن يدخل المرء ولا يبالي في هذه المواقع الموبوءة"
    },
    {
     "t0": 56.5,
     "t1": 60.5,
     "text": "والأماكن المشبوهة وأماكن الرذيلة"
    },
    {
     "t0": 60.5,
     "t1": 65.5,
     "text": "وفي الوقت نفسه يريد أن يبقى إيمانه سليمًا؟"
    },
    {
     "t0": 65.5,
     "t1": 69.5,
     "text": "هيهات! ألقاه في اليمّ مكتوفًا",
     "emph": true
    },
    {
     "t0": 69.5,
     "t1": 73.5,
     "text": "وقال له: إياك أن تبتلّ بالماء"
    },
    {
     "t0": 73.5,
     "t1": 79.1,
     "text": "لا بدّ من الأخذ بوسائل النجاة بإغلاق هذه المنافذ",
