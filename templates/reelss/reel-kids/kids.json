   "type": "words",
   "lines": [
    {
     "who": "nour",
     "name": "نُور",
     "text": "مَعْنَى الْحَدِيثِ: أَنَّ إِيمَانَنَا لَا يَكْتَمِلُ حَتَّى نُحِبَّ لِغَيْرِنَا الْخَيْرَ الَّذِي نُحِبُّهُ لِأَنْفُسِنَا.",
     "audio": "d_s5_0.mp3",
     "t0": 0.3,
     "d": 8.07
    }
   ],
   "duration": 9.07,
