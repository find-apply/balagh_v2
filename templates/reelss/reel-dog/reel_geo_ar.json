   "hook": "الشيطان كلبٌ جائع يدور حول إيمانك",
   "speaker": "الشيخ عبد الرزاق البدر · تجديد الإيمان",
   "cues": [
    {
     "t0": 0.1,
     "t1": 5.0,
     "text": "ضرب ابن القيم رحمه الله مثالًا"
    },
    {
     "t0": 5.0,
     "t1": 8.8,
     "text": "لبيان حال الشيطان مع الإنسان"
    },
    {
     "t0": 8.8,
     "t1": 11.1,
     "text": "مثالٌ يوضّح"
    },
    {
     "t0": 11.1,
     "t1": 15.1,
     "text": "يقول: مثل الشيطان والإنسان"
    },
    {
     "t0": 15.1,
     "t1": 19.0,
     "text": "كمثل شخص معه قطعة من اللحم"
    },
    {
     "t0": 19.0,
     "t1": 23.2,
     "text": "القطعة من اللحم هي الإيمان",
     "emph": true
    },
    {
     "t0": 23.2,
     "t1": 26.9,
     "text": "بين يديه، وحوله كلب جائع"
    },
    {
     "t0": 26.9,
     "t1": 29.9,
     "text": "يطوف به من كل جهة"
    },
    {
     "t0": 29.9,
     "t1": 32.9,
     "text": "ينتظر أقلّ غفلة"
    },
    {
     "t0": 32.9,
     "t1": 35.5,
     "text": "من صاحب اللحم ليخطف منه لحمه"
    },
    {
     "t0": 35.5,
     "t1": 38.9,
     "text": "وهذه حال الشيطان، يطوف بالإنسان من كل جهة"
    },
    {
     "t0": 38.9,
     "t1": 41.9,
     "text": "وقاعد له بكل طريق"
    },
    {
     "t0": 41.9,
     "t1": 43.6,
     "text": "كما قال نبينا ﷺ"
    },
    {
     "t0": 43.6,
     "t1": 50.4,
     "text": "إنّ الشيطان قاعدٌ لابن آدم بأطرقه، بكل طريق",
     "emph": true
    },
    {
     "t0": 50.4,
     "t1": 55.6,
     "text": "وكما قال بعض السلف: عدوٌّ يراك ولا تراه، شديد المؤنة",
     "emph": true
    },
    {
     "t0": 55.6,
     "t1": 59.0,
     "text": "لكن هذه المؤنة الشديدة"
    },
    {
     "t0": 59.0,
     "t1": 64.8,
     "text": "تهون مع قوة الصلة بالله والذكر لله"
    },
    {
     "t0": 64.8,
     "t1": 69.5,
     "text": "فإنّ ذكر الله حصنٌ حصين من الشيطان الرجيم",
     "emph": true
    },
    {
     "t0": 69.5,
     "t1": 73.2,
     "text": "إنّ عبادي ليس لك عليهم سلطان",
     "sub": "سورة الإسراء ٦٥"
    },
    {
     "t0": 73.2,
     "t1": 75.9,
     "text": "العبد الذاكر لله الملتجئ إليه"
    },
    {
     "t0": 75.9,
     "t1": 77.9,
     "text": "ليس للشيطان عليه سبيل",
     "emph": true
