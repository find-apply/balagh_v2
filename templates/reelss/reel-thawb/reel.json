   "cues": [
    {
     "t0": 0.4,
     "t1": 6.4,
     "text": "إنّ الإيمان ليَخلَق في جوف أحدكم",
     "emph": true
    },
    {
     "t0": 6.4,
     "t1": 10.4,
     "text": "كما يَخلَق الثوب",
     "emph": true
    },
    {
     "t0": 10.4,
     "t1": 14.4,
     "text": "فاسألوا الله أن يجدّد الإيمان في قلوبكم"
    },
    {
     "t0": 14.4,
     "t1": 18.4,
     "text": "انظر إلى هذا الثوب الذي تلبسه"
    },
    {
     "t0": 18.4,
     "t1": 24.6,
     "text": "وتعتني بنظافته وتعاهده دائمًا"
    },
    {
     "t0": 24.6,
     "t1": 27.6,
     "text": "ولو أصيب بشيء من الأوساخ لا يصبر على بقائها"
    },
    {
     "t0": 27.6,
     "t1": 34.6,
     "text": "بل يريد أن يبقى ناصعًا نقيًّا أبيض صافيًا"
    },
    {
     "t0": 34.6,
     "t1": 38.6,
     "text": "سليمًا من الأوساخ"
    },
    {
     "t0": 38.6,
     "t1": 47.6,
     "text": "وإذا كان الثوب الذي يحرص كل أحد على جدّته ونظافته"
    },
    {
     "t0": 47.6,
     "t1": 53.6,
     "text": "يخلَق، ويصيبه ما يصيبه من الأوساخ"
    },
    {
     "t0": 53.6,
     "t1": 57.6,
     "text": "فيحتاج إلى غسل وتعاهد وعناية",
     "emph": true
    },
    {
     "t0": 57.6,
     "t1": 60.6,
     "text": "فإنّ مقام الإيمان أعظم"
    },
    {
     "t0": 60.6,
     "t1": 68.6,
     "text": "وشأن الدين أكبر، وأمره أجلّ"
    },
    {
     "t0": 68.6,
     "t1": 73.6,
     "text": "ومن كان يعتني بثوبه فلا حرج عليه"
    },
    {
     "t0": 73.6,
     "t1": 80.2,
     "text": "لكن إيمانه أولى بالعناية، وأجدر بالاهتمام",
     "emph": true
    }
   ]
