   ],
   "cues": [
    {
     "t0": 0.4,
     "t1": 6.4,
     "text": "Faith wears out inside one of you",
     "emph": true
    },
    {
     "t0": 6.4,
     "t1": 10.4,
     "text": "just as a garment wears out.",
     "emph": true
    },
    {
     "t0": 10.4,
     "t1": 14.4,
     "text": "So ask Allah to renew faith in your hearts."
    },
    {
     "t0": 14.4,
     "t1": 18.4,
     "text": "Look at this garment you're wearing,"
    },
    {
     "t0": 18.4,
     "t1": 24.6,
     "text": "you care for it, keep it clean, and look after it constantly."
    },
    {
     "t0": 24.6,
     "t1": 27.6,
     "text": "If it gets a little dirty, you can't stand it staying that way."
    },
    {
     "t0": 27.6,
     "t1": 34.6,
     "text": "You want it bright, clean, and white,"
    },
    {
     "t0": 34.6,
     "t1": 38.6,
     "text": "free of any stain."
    },
    {
     "t0": 38.6,
     "t1": 47.6,
     "text": "And if the garment you take such care to keep new and clean"
    },
    {
     "t0": 47.6,
     "t1": 53.6,
     "text": "wears out and gets dirty,"
    },
    {
     "t0": 53.6,
     "t1": 57.6,
     "text": "it needs washing, care, and attention.",
     "emph": true
    },
    {
     "t0": 57.6,
     "t1": 60.6,
     "text": "Then the station of faith is far greater,"
    },
    {
     "t0": 60.6,
     "t1": 68.6,
     "text": "and the matter of religion is weightier."
    },
    {
     "t0": 68.6,
     "t1": 73.6,
     "text": "Whoever takes care of his clothes, there is no blame on him,"
    },
    {
     "t0": 73.6,
     "t1": 80.2,
     "text": "but his faith is more deserving of care and more worthy of attention.",
     "emph": true
    }
   ]
  },
